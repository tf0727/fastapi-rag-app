    },
    {
        "type": "text",
        "text": "|上海交通大学副教授、博士生导师",
        "page_idx": 21
    },
    {
        "type": "image",
        "img_path": "images/ace72c397e13a9eeef84534058b89e18b5bc3c7fb4b45bce27223f9eace91a06.jpg",
