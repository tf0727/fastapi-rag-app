# Copy to .env and fill in your own credentials. Never commit .env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus

# Use a local model path or a Hugging Face model identifier.
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu
VECTORSTORE_PATH=./faiss-pkl
ELASTICSEARCH_URL=http://127.0.0.1:9200
MAX_HISTORY_MESSAGES=20

# Optional tracing; unrelated to authentication for the FastAPI endpoints.
LANGSMITH_PROJECT=xiaomi-rag
LANGSMITH_API_KEY=
